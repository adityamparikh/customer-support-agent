# Copy to .env (gitignored) and fill in. Load it into your shell before running:
#   set -a; . ./.env; set +a
#
# Prefer project-scoped keys with a monthly spend limit for this repo.

# Required to run the app (./mvnw spring-boot:run): chat model gpt-5.4 and
# embeddings text-embedding-3-small. Read via ${OPENAI_API_KEY} in application.properties.
OPENAI_API_KEY=

# Required only for the paid integration tests (./mvnw verify -Plive-it):
# Claude Haiku 4.5 is the LLM-as-a-judge in CustomerSupportAgentIT.
ANTHROPIC_API_KEY=
